{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4444555.xyz/schemas/game-manifest.schema.json",
  "title": "4444555 game manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "sdk", "status", "title", "summary", "engine", "entry", "presentation", "input", "sessions", "assets", "scores", "achievements", "save"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sdk": { "type": "string" },
    "status": { "enum": ["concept", "visual-gate", "prototype", "beta", "released", "retired"] },
    "title": { "type": "string", "minLength": 2 },
    "summary": { "type": "string", "minLength": 20 },
    "engine": { "type": "object", "required": ["name", "version", "rendering"], "properties": { "name": {"type":"string"}, "version":{"type":"string"}, "rendering":{"type":"string"} }, "additionalProperties": false },
    "entry": { "type": "string", "pattern": "^/" },
    "presentation": { "type": "object" },
    "input": { "type": "array", "minItems": 1, "items": { "enum": ["keyboard", "pointer", "touch", "gamepad"] }, "uniqueItems": true },
    "sessions": { "type": "object" },
    "assets": { "type": "object", "required": ["initialBytes", "totalBytes"], "properties": { "initialBytes": {"type":"integer","minimum":0}, "totalBytes":{"type":"integer","minimum":0} }, "additionalProperties": false },
    "scores": { "type": "object" },
    "achievements": { "type": "array", "items": { "type": "object", "required": ["id", "title", "target"], "properties": { "id":{"type":"string"}, "title":{"type":"string"}, "target":{"type":"number","exclusiveMinimum":0} }, "additionalProperties": false } },
    "save": { "type": "object", "required": ["schemaVersion", "maximumBytes"], "properties": { "schemaVersion":{"type":"integer","minimum":1}, "maximumBytes":{"type":"integer","minimum":1} }, "additionalProperties": false }
  }
}
